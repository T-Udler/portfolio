---
import { getYouTubeThumbnail } from '../utils/youtube';

interface Props {
  num: string;
  title: string;
  category?: string;
  date?: Date;
  videoUrl?: string;
  featured: boolean;
}

const { num, title, category, date, videoUrl, featured } = Astro.props;
const thumbnail = videoUrl ? getYouTubeThumbnail(videoUrl) : null;
const meta = [category, date?.getFullYear()].filter(Boolean).join(' — ');
---

<a
  class="entry"
  href={videoUrl}
  target={videoUrl ? '_blank' : undefined}
  rel="noopener noreferrer"
  data-category={category}
  data-featured={featured ? 'true' : 'false'}
>
  <div class="entry-head">
    <span class="num">{num}</span>
    <span class="title">{title}</span>
  </div>
  <div class="thumb">
    {
      thumbnail ? (
        <img src={thumbnail} alt={title} loading="lazy" />
      ) : (
        <div class="thumb-fallback" />
      )
    }
    <div class="play">
      <svg width="14" height="16" viewBox="0 0 24 28" fill="rgba(255,255,255,0.95)"><path d="M2 2 L22 14 L2 26 Z" /></svg>
    </div>
  </div>
  {meta && <div class="meta">{meta}</div>}
</a>

<style>
  .entry {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }

  .entry[hidden] {
    display: none;
  }

  .entry-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    min-width: 0;
  }

  .num {
    color: var(--text-faint);
    flex-shrink: 0;
  }

  .title {
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .thumb {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--bg-elevated);
    overflow: hidden;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .entry:hover .thumb img {
    transform: scale(1.03);
  }

  .thumb-fallback {
    width: 100%;
    height: 100%;
    background: var(--bg-elevated);
  }

  .play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.15);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .entry:hover .play {
    opacity: 1;
  }

  .play > svg {
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid var(--text);
    border-radius: 50%;
    padding: 16px;
    width: 46px;
    height: 46px;
    box-sizing: border-box;
  }

  .meta {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
</style>
