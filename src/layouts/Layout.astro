---
import '../styles/global.css';
import { profile } from '../data/profile';
import AmbientBackground from '../components/AmbientBackground.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = profile.name, description = profile.bio } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,300..500;1,6..96,300..500&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title} — Portfolio</title>
  </head>
  <body>
    <AmbientBackground />
    <slot />
  </body>
</html>
